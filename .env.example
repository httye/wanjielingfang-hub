# 复制为 .env 后按需修改（PowerShell 里用 $env:KEY="value" 设置，或由部署脚本注入）

# --- 基础 ---
PORT=8080
DATA_DIR=data
DB_PATH=data/hub.db
ARTIFACT_DIR=data/artifacts

# --- 安全（生产必填）---
JWT_SECRET=change-me-to-a-long-random-string
ADMIN_PASSWORD=change-me-strong
COOKIE_NAME=mcai_token
# 同域共享登录态时填父域，例如 .example.com
COOKIE_DOMAIN=
# HTTPS 下设为 1
COOKIE_SECURE=0

# --- 跨域（卫星站与服务同域时留空）---
ALLOWED_ORIGINS=

# --- AI（不填自动进入 mock 模式）---
AI_BASE_URL=https://api.deepseek.com/v1
AI_API_KEY=
AI_MODEL=deepseek-chat
AI_MOCK=

# --- worker 注册 ---
WORKER_ENROLL_KEY=

# --- 开发 ---
# DEV=1 时使用固定 JWT_SECRET，省去反复登录
DEV=
